# Disposable half of the lab: the preemptible L40S VM. `terraform destroy` here
# removes the VM and its boot disk only; network, firewall, keys and the jump
# server stay in ../base, so the next `terraform apply` is a clean rebuild.

data "terraform_remote_state" "base" {
  backend = "local"
  config = {
    path = "${path.module}/../base/terraform.tfstate"
  }
}

locals {
  base = data.terraform_remote_state.base.outputs
}

resource "nebius_compute_v1_instance" "gpu" {
  name = "${var.name}-gpu"

  resources = {
    platform = var.platform
    preset   = var.preset
  }

  preemptible     = var.preemptible ? { on_preemption = "STOP" } : null
  recovery_policy = var.preemptible ? "FAIL" : null

  boot_disk = {
    attach_mode = "READ_WRITE"
    managed_disk = {
      name = "${var.name}-gpu-boot"
      spec = {
        type                = "NETWORK_SSD"
        size_gibibytes      = var.boot_disk_gib
        source_image_family = { image_family = var.image_family }
      }
    }
  }

  # The public IP is for outbound traffic only (images, weights); the security
  # group from ../base admits nothing but the jump server.
  network_interfaces = [{
    name              = "eth0"
    subnet_id         = local.base.subnet_id
    ip_address        = {}
    public_ip_address = {}
    security_groups   = [{ id = local.base.gpu_security_group_id }]
  }]

  cloud_init_user_data = templatefile("${path.module}/templates/gpu-cloud-init.yaml.tftpl", {
    ssh_user       = local.base.ssh_user
    ssh_public_key = local.base.ssh_public_key
    repo_url       = var.repo_url
    repo_ref       = var.repo_ref
    api_image      = var.api_image
    frontend_image = var.frontend_image
    bootstrap      = file("${path.module}/templates/ocr-lab-bootstrap.sh")
  })
}

locals {
  private_ip = split("/", nebius_compute_v1_instance.gpu.status.network_interfaces[0].ip_address.address)[0]
}

resource "local_file" "ssh_config" {
  filename = "${local.base.secrets_dir}/ssh_config.gpu"
  content  = <<-EOT
    # Generated by infra/nebius/gpu; rewritten on every rebuild.
    Host ocr-gpu
      HostName ${local.private_ip}
      User ${local.base.ssh_user}
      IdentityFile ${local.base.secrets_dir}/id_ed25519
      IdentitiesOnly yes
      # A rebuilt VM has a new host key on the same name.
      UserKnownHostsFile /dev/null
      StrictHostKeyChecking no
      LogLevel ERROR
  EOT
}
