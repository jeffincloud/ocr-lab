      "type": "timeseries",
      "title": "Requests by outcome",
      "description": "ok, bad_request (4xx) and the 5xx outcomes that burn the availability budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
