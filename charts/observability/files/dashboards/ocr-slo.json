      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(ocr_mrz_checks_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
